# Every variable qone-advisor-portal reads (norm 5.1). Copy to .env and fill; .env is ignored.
# Origin of the shell (qone-front) whose remoteEntry.js provides shell/apiClient and shell/session.
# The portal never knows the gateway URL or the token (norm 5.4.1): those live in the shell.
VITE_SHELL_URL=http://localhost:5173
