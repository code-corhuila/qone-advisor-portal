{
  "name": "qone-advisor-portal",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Qampus advisor portal: the chat with the academic advisor and the enrollment plans it proposes, as a Module Federation remote of qone-front",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:isolation": "sh scripts/check-isolation.sh",
    "contracts:sync": "sh scripts/sync-contracts.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.1.0",
    "msw": "^2.10.0",
    "typescript": "~5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  }
}
